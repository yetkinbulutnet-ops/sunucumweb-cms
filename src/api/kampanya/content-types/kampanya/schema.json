        "users",
        "refresh",
        "layers",
        "wifi",
        "scale",
        "rocket",
        "doc",
        "chat",
        "terminal",
        "sparkles",
        "copy",
        "xmark",
        "question",
        "pencil",
        "sun",
        "moon",
        "cart",
        "trash",
        "plus",
        "minus",
        "user",
        "signal",
        "ban",
        "kurumsal",
        "magaza",
        "vds",
