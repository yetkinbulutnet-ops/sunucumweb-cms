{
  "kind": "collectionType",
  "collectionName": "kampanyalar",
  "info": {
    "singularName": "kampanya",
    "pluralName": "kampanyalar",
    "displayName": "Kampanya",
    "description": "Kampanyalar sayfasındaki fırsatlar"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "baslik": {
      "type": "string",
      "required": true,
      "maxLength": 90
    },
    "slug": {
      "type": "uid",
      "targetField": "baslik",
      "required": true
    },
    "sira": {
      "type": "integer",
      "default": 0
    },
    "kategori": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "ikon": {
      "type": "customField",
      "customField": "global::ikon",
      "required": true,
      "default": "tag"
    },
    "aciklama": {
      "type": "text",
      "required": true,
      "maxLength": 400
    },
    "indirim": {
      "type": "integer",
      "min": 0,
      "max": 100
    },
    "eskiFiyat": {
      "type": "decimal",
      "min": 0
    },
    "yeniFiyat": {
      "type": "decimal",
      "min": 0
    },
    "periyot": {
      "type": "string",
      "default": "/yıl",
      "maxLength": 20
    },
    "kupon": {
      "type": "string",
      "maxLength": 40
    },
    "bitisTarihi": {
      "type": "date"
    },
    "rozet": {
      "type": "string",
      "maxLength": 30
    },
    "rozetTonu": {
      "type": "enumeration",
      "enum": [
        "yesil",
        "sari",
        "mavi",
        "kirmizi"
      ],
      "default": "yesil"
    },
    "vurgu": {
      "type": "boolean",
      "default": false
    },
    "baglanti": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "butonMetni": {
      "type": "string",
      "default": "İncele",
      "maxLength": 40
    }
  }
}
