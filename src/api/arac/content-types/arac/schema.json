{
  "kind": "collectionType",
  "collectionName": "araclar",
  "info": {
    "singularName": "arac",
    "pluralName": "araclar",
    "displayName": "Araç",
    "description": "Ücretsiz ağ ve alan adı araçlarının metinleri"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "baslik": {
      "type": "string",
      "maxLength": 80,
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 40
    },
    "kisa": {
      "type": "string",
      "maxLength": 40,
      "required": true
    },
    "ozet": {
      "type": "string",
      "maxLength": 200,
      "required": true
    },
    "ikon": {
      "type": "customField",
      "customField": "global::ikon",
      "required": true,
      "default": "server"
    },
    "girdiEtiketi": {
      "type": "string",
      "maxLength": 40
    },
    "ornek": {
      "type": "string",
      "maxLength": 60
    },
    "girdiOpsiyonel": {
      "type": "boolean",
      "default": false
    },
    "aciklama": {
      "type": "text",
      "maxLength": 1500,
      "required": true
    },
    "seo": {
      "type": "text",
      "maxLength": 200,
      "required": true
    },
    "aktif": {
      "type": "boolean",
      "default": true
    },
    "sira": {
      "type": "integer",
      "default": 0
    }
  }
}
