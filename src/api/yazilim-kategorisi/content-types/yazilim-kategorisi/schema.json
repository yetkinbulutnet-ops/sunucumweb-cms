      "enum": [
        "bolt",
        "shield",
        "headset",
        "lock",
        "check",
        "arrow",
        "chevron",
        "search",
        "server",
        "globe",
        "cpu",
        "database",
        "cloud",
        "gauge",
        "clock",
        "phone",
        "mail",
        "pin",
        "star",
        "users",
        "refresh",
        "layers",
        "wifi",
        "scale",
        "rocket",
        "doc",
        "chat",
        "terminal",
        "sparkles",
        "copy",
        "xmark",
        "question",
        "pencil",
        "sun",
        "moon",
        "cart",
        "trash",
        "plus",
        "minus",
        "user",
        "signal",
        "ban",
        "kurumsal",
        "magaza",
        "vds",
        "dedicated",
        "gpu",
        "colocation",
        "wrench",
        "external",
        "tag",
        "gift",
        "percent"
