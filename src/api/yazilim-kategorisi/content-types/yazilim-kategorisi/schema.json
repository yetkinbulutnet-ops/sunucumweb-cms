{
  "kind": "collectionType",
  "collectionName": "yazilim_kategorileri",
  "info": {
    "singularName": "yazilim-kategorisi",
    "pluralName": "yazilim-kategorileri",
    "displayName": "Yazılım Kategorisi",
    "description": "Hazır yazılım kategorileri"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "ad": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "slug": {
      "type": "uid",
      "targetField": "ad",
      "required": true
    },
    "ikon": {
      "type": "customField",
      "customField": "global::ikon",
      "required": true,
      "default": "layers"
    },
    "sira": {
      "type": "integer",
      "default": 0
    },
    "yazilimlar": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::hazir-yazilim.hazir-yazilim",
      "mappedBy": "kategori"
    }
  }
}
