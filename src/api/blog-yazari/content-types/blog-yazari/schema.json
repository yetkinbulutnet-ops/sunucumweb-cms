      "type": "string",
      "maxLength": 80
    },
    "biyografi": {
      "type": "text",
      "maxLength": 500
    },
    "fotograf": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "yazilar": {
